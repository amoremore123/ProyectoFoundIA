# =====================================================================
# FoundIA · Variables de entorno de ejemplo
# Copia este archivo como .env (en la misma carpeta) y completa tus valores.
# El archivo .env está en .gitignore: NUNCA subas tu clave a Git.
# =====================================================================

# --- Fase 5: FINDI con inteligencia artificial ---
# Formato compatible con OpenAI. Para la demo se usa Groq (plan gratuito):
#   1. Crea tu clave en https://console.groq.com/keys
#   2. Pégala en IA_API_KEY
# Para usar OpenAI: IA_URL=https://api.openai.com/v1 y un modelo de OpenAI en IA_MODELO.
# Sin clave, FINDI sigue funcionando con su motor local.
IA_URL=https://api.groq.com/openai/v1
IA_MODELO=llama-3.1-8b-instant
IA_API_KEY=

# H45 integrado: primero se intenta IA_API_KEY; si no produce una interpretación
# válida, se intenta Claude (si está habilitado) y finalmente el motor local del servidor.
ASISTENTE_CLAUDE_ENABLED=false
ANTHROPIC_API_KEY=
ASISTENTE_CLAUDE_MODEL=claude-sonnet-4-5
ASISTENTE_LIMITE_POR_MINUTO=20

# --- Fase 6: voz natural de FINDI con ElevenLabs (opcional) ---
#   1. Crea tu clave en https://elevenlabs.io/app/settings/api-keys
#   2. Elige una voz predeterminada en tu panel y copia su "Voice ID" en VOZ_ID
# El plan gratuito tiene unos 10 000 caracteres al mes y pide dar crédito a ElevenLabs.
# VOZ_LIMITE_CARACTERES_DIA corta el uso diario para no agotar el cupo (después se usa la voz del navegador).
VOZ_API_KEY=
VOZ_ID=
VOZ_MODELO=eleven_flash_v2_5
VOZ_LIMITE_CARACTERES_DIA=2000

# Extras del Sprint 1 (opcional)
HABILITAR_EXTRAS=false
